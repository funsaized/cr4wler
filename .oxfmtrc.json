{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "artifacts",
    "package-lock.json",
    "*.png",
    "*.webm",
    "*.py"
  ]
}
